# ── 필수 (현재 보유) ─────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── 발급 대기 (넣는 즉시 해당 어댑터가 실 API로 전환됨) ──────
# fal.ai — SAM 3 segmentation  (https://fal.ai/models/fal-ai/sam-3)
FAL_KEY=
# Vectorizer.AI — raster→vector (https://vectorizer.ai/api)
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
# Adobe Firefly Services — Illustrator Custom Scripts (선택)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Adobe Image Trace는 공개 URL 입력만 받는다 (localhost 불가)
PUBLIC_BASE_URL=

# ── 모델명 (API가 바뀌면 여기만 수정) ────────────────────────
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_VISION_MODEL=gemini-2.5-flash
# 4K | 2K | 1K — Gemini 이미지 생성 해상도
GEMINI_IMAGE_SIZE=2K

# ── 파이프라인 튜닝 ──────────────────────────────────────────
# 스타일당 생성할 candidate 수 (모델별. 총 2배가 생성됨)
CANDIDATES_PER_MODEL=2
# 선 레이어 패스 상한 — 낮추면 가볍고, 높이면 충실도가 올라간다
LINE_BUDGET=20000
# 질감 억제 — 제품 최소변 대비 이 비율보다 짧은 선은 질감으로 보고 제거
# 0.006=질감 유지, 0.035=구조선만(테크팩 기본)
TEXTURE_MIN_LEN=0.035
API_PORT=5201

# ── 공개 API 운영 (외부 공유 시) ─────────────────────────────
# 콤마로 구분한 API 키 목록. 비워 두면 인증 없이 열린다(로컬 개발용).
# 공개 배포 시 반드시 채울 것: API_KEYS=key_abc123,key_def456
API_KEYS=
# 동시에 돌릴 잡 수. 외부 모델 비용·레이트리밋 때문에 낮게 잡는다
MAX_CONCURRENT_JOBS=2
# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=30
# 허용 오리진 (콤마 구분). 비우면 모두 허용
CORS_ORIGINS=
# API 포트
API_PORT=5201
